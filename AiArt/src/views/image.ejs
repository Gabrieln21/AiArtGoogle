<% layout('partials/_layout', { title: piece.prompt.slice(0, 40), route: '' }) %>

<figure class="max-w-4xl mx-auto px-4">
    <div class="rounded-2xl bg-white shadow-xl px-3 pt-3 sm:px-6 sm:pt-6">
        <img
                src="<%= piece.publicUrl %>"
                alt="<%= piece.prompt %>"
                loading="lazy"
                decoding="async"
                sizes="(max-width:640px) 92vw, 720px"
                class="mx-auto block w-auto max-w-[min(92vw,720px)] max-h-[78dvh] object-contain rounded-lg"
        />
    </div>

    <figcaption class="mt-5">
        <p class="text-lg sm:text-xl font-serif italic mb-2"><%= piece.prompt %></p>
        <p class="text-sm text-gray-500">
            Generated via <%= piece.model %> · <%= piece.created_at.toLocaleString() %>
        </p>

        <a href="<%= piece.publicUrl %>" download
           class="mt-4 inline-block px-4 py-3 text-sm font-medium border border-gray-800 rounded-md hover:bg-gray-800 hover:text-white">
            Download PNG
        </a>
    </figcaption>
</figure>

<!-- ───────── Regenerate form ───────── -->
<form id="regen"
      class="mt-10 max-w-4xl mx-auto px-4 grid grid-cols-1 sm:grid-cols-3 gap-3"
      enctype="multipart/form-data">
    <input name="feedback" type="text" required
           placeholder="Change something…"
           class="sm:col-span-2 border px-4 py-3 rounded-md text-base w-full" />

    <input name="files" type="file" multiple
           class="border px-4 py-3 rounded-md text-base w-full" />

    <button class="sm:col-span-3 px-4 py-3 bg-gray-900 text-white rounded-md">
        Regenerate
    </button>
</form>

<script>
    document.getElementById('regen').addEventListener('submit', async (e) => {
        e.preventDefault();
        const fd  = new FormData(e.target);
        const res = await fetch('/api/regenerate/<%= piece.id %>', {
            method: 'POST',
            body: fd
        });
        const data = await res.json();
        location.href = '/image/' + data.id;  // jump to the new version
    });
</script>
