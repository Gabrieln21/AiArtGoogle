<h1 class="text-2xl font-semibold mb-4">Print Queue</h1>

<% const qs = (typeof adminKey !== 'undefined' && adminKey) ? ('?key=' + encodeURIComponent(adminKey)) : ''; %>


<table class="w-full text-sm">
    <thead>
    <tr class="border-b">
        <th class="text-left py-2">Job</th>
        <th class="text-left">Status</th>
        <th class="text-left">Image</th>
        <th class="text-left">Caption</th>
        <th class="text-left">Created</th>
        <th class="text-right pr-2">Actions</th>
    </tr>
    </thead>
    <tbody>
    <% (jobs || []).forEach(j => { %>
        <tr class="border-b align-top">
            <td class="py-2"><%= j.id %></td>
            <td><%= j.status %></td>
            <td class="py-2">
                <a href="<%= j.public_url %>" target="_blank">
                    <img src="<%= j.public_url %>" alt="" class="w-32 h-auto rounded border" />
                </a>
            </td>
            <td class="max-w-xs truncate"><%= j.caption %></td>
            <td><%= new Date(j.created_at).toLocaleString() %></td>
            <td class="text-right space-x-2">
                <!-- Download the image -->
                <a href="<%= j.public_url %>" download
                   class="px-2 py-1 border rounded inline-block align-middle">
                    ⬇ Download
                </a>

                <!-- Print the image (opens a print-only window and calls window.print) -->
                <button type="button"
                        class="px-2 py-1 border rounded inline-block align-middle btn-print"
                        data-url="<%= j.public_url %>"
                        data-id="<%= j.id %>">
                    🖨 Print
                </button>

                <!-- Admin actions with key preserved -->
                <form method="POST" action="/api/admin/prints/<%= j.id %>/done<%= qs %>" style="display:inline">
                    <button class="px-2 py-1 border rounded">Mark Done</button>
                </form>
                <form method="POST" action="/api/admin/prints/<%= j.id %>/requeue<%= qs %>" style="display:inline">
                    <button class="px-2 py-1 border rounded">Requeue</button>
                </form>
                <form method="POST" action="/api/admin/prints/<%= j.id %>/delete<%= qs %>" style="display:inline" onsubmit="return confirm('Delete job?')">
                    <button class="px-2 py-1 border rounded text-red-600">Delete</button>
                </form>
            </td>
        </tr>
    <% }) %>
    </tbody>
</table>
<script>
    // Delegate click handling for any ".btn-print" on the page
    document.addEventListener('click', function (e) {
        const btn = e.target.closest('.btn-print');
        if (!btn) return;

        e.preventDefault();
        const url = btn.getAttribute('data-url');
        if (!url) return;

        // Open a minimal, print-friendly window
        const w = window.open('', '_blank', 'width=900,height=1200');
        if (!w) {
            alert('Popup blocked. Please allow popups to print.');
            return;
        }

        const html = `
<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <title>Print</title>
  <style>
    @page { size: auto; margin: 0.5in; }
    html, body { height: 100%; }
    body { display: flex; align-items: center; justify-content: center; }
    img { max-width: 100%; max-height: 100%; }
  </style>
</head>
<body>
  <img src="${url}" onload="setTimeout(() => { window.focus(); window.print(); }, 50)" />
</body>
</html>`;
        w.document.open();
        w.document.write(html);
        w.document.close();
    });
</script>
