<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
    <meta charset="UTF-8" />
    <title>Irene Carvajal – Art & Experiments</title>
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">

    <!-- Tailwind CDN -->
    <script src="https://cdn.tailwindcss.com"></script>

    <!-- Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Lora:ital@0;1&display=swap" rel="stylesheet">
    <style>
        body { font-family: Inter, sans-serif; }

        /* Masonry grid stays CSS-column based (lightweight & responsive) */
        .masonry-grid {
            column-count: 4;
            column-gap: 20px;
            column-fill: balance;
        }
        @media (max-width: 1280px) { .masonry-grid { column-count: 3; } }
        @media (max-width: 1024px) { .masonry-grid { column-count: 2; } }
        @media (max-width: 640px)  { .masonry-grid { column-count: 1; } }

        .masonry-item {
            break-inside: avoid;
            margin-bottom: 20px;
            display: inline-block;
            width: 100%;
            background-color: #f3f4f6;
            contain: layout paint style; /* slightly stronger containment */
            transform: translateZ(0);
        }

        .gallery-img {
            will-change: transform, opacity;
            backface-visibility: hidden;
            transform: translateZ(0);
            transition: transform .3s ease, filter .3s ease, opacity .3s ease;
            filter: brightness(1) contrast(1);
        }
        .gallery-img:hover {
            transform: translateY(-2px) scale(1.015);
            filter: brightness(1.05) contrast(1.08);
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.12), 0 2px 8px rgba(0, 0, 0, 0.08);
        }

        /* On touch devices, don’t rely on hover flourishes */
        @media (hover: none) {
            .gallery-img:hover { transform:none; filter:none; box-shadow:none; }
        }
        @media (prefers-reduced-motion: reduce) {
            .gallery-img { transition: none; }
        }

        /* Details popovers: static on mobile, floating panel on large screens */
        .details-panel {
            width: 100%;
        }
        @media (min-width: 1024px) {
            .details-panel {
                position: absolute;
                left: 0;
                top: 100%;
                width: 48rem; /* ~max-w-4xl */
            }
        }
    </style>
</head>
<body class="h-full bg-white text-gray-800 antialiased">
<main class="min-h-screen pt-10 px-4">
    <section class="px-4 space-y-4">
        <h1 class="text-2xl font-semibold text-gray-900 mb-2">Original Print Paradox</h1>

        <div class="flex flex-wrap gap-3 mt-2">
            <details class="relative inline-block" data-exclusive>
                <summary class="cursor-pointer inline-flex items-center gap-2 px-2 py-1 rounded-md text-gray-700 hover:bg-gray-100">
                    How this will be used
                </summary>
                <div class="details-panel mt-2 lg:mt-2 bg-white border border-gray-300 rounded lg:shadow-md p-4 text-sm text-gray-700 z-10">
                    At Google’s Huddle Space you can print out your image and participate in a 2 hour printmaking workshop. With Irene’s guidance and using traditional printing techniques you will interact with the image. Upon finishing the workshop you will have at least one mono print to take with you.
                </div>
            </details>

            <details class="relative inline-block" data-exclusive>
                <summary class="cursor-pointer inline-flex items-center gap-2 px-2 py-1 rounded-md text-gray-700 hover:bg-gray-100">
                    Terms of use
                </summary>
                <div class="details-panel mt-2 lg:mt-2 bg-white border border-gray-300 rounded lg:shadow-md p-4 text-sm text-gray-700 z-10">
                    By clicking below you are giving Irene Carvajal permission to reconfigure your image in the context of a larger installation to be shown at Google’s Huddle space. We will be announcing the dates of this exhibition soon. Participants will be given all due credit.
                </div>
            </details>
        </div>

        <div class="flex items-center space-x-2 pt-4">
            <input type="checkbox" id="consentCheckbox" class="accent-gray-900 w-5 h-5" />
            <label for="consentCheckbox" class="text-gray-700">I agree to the terms above</label>
        </div>

        <form id="genForm" class="w-full space-y-4 pt-4" enctype="multipart/form-data">
            <input id="promptInput" name="prompt" type="text" placeholder="Main image description…"
                   class="w-full border border-gray-300 px-4 py-3 rounded-md text-base focus:border-gray-500 focus:ring-0 transition-colors" />
            <input id="lastSearchInput" name="lastSearch" type="text" placeholder="Your last Google search"
                   class="w-full border border-gray-300 px-4 py-3 rounded-md text-base focus:border-gray-500 focus:ring-0 transition-colors" />
            <button id="genBtn" type="submit"
                    class="w-full px-4 py-3 bg-gray-900 text-white rounded-md hover:bg-gray-800 text-base transition-colors disabled:opacity-50"
                    disabled>
                Generate
            </button>
        </form>
        <p id="status" class="text-sm text-gray-500 mt-2 hidden"></p>
    </section>

    <section id="gallery" class="masonry-grid mt-12 px-4">
        <% (images || []).forEach(img => { %>
            <div class="aspect-[4/3] rounded overflow-hidden masonry-item">
                <img
                        loading="lazy"
                        decoding="async"
                        sizes="(max-width:640px) 100vw, (max-width:1024px) 50vw, (max-width:1280px) 33vw, 25vw"
                        src="<%= img.publicUrl %>"
                        alt="<%= img.prompt %>"
                        data-id="<%= img.id %>"
                        data-url="<%= img.publicUrl %>"
                        data-prompt="<%= img.prompt %>"
                        onclick="openModal(this)"
                        class="gallery-img w-full h-full object-cover rounded cursor-pointer opacity-0 transition-opacity duration-300 ease-in-out"
                />
            </div>
        <% }) %>
    </section>
</main>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        document.querySelectorAll('.gallery-img').forEach(img => {
            if (img.complete) {
                img.classList.remove('opacity-0');
            } else {
                img.addEventListener('load', () => img.classList.remove('opacity-0'));
            }
        });
    });

    const form = document.getElementById('genForm');
    const input = document.getElementById('promptInput');
    const status = document.getElementById('status');
    const gallery = document.getElementById('gallery');

    form.addEventListener('submit', async (e) => {
        e.preventDefault();

        const userInput = input.value.trim();
        const lastSearch = document.getElementById('lastSearchInput').value.trim();
        if (!userInput) return;

        status.textContent = 'Creating… ⏳';
        status.classList.remove('hidden');

        try {
            const body = new FormData();
            body.append('prompt', userInput);
            body.append('lastSearch', lastSearch);

            const res = await fetch('/api/generate', { method: 'POST', body });
            if (!res.ok) {
                const errorData = await res.text();
                status.textContent = 'Error: ' + errorData;
                status.className = 'text-sm text-red-600 mt-2';
                return;
            }
            const data = await res.json();

            const masonryItem = document.createElement('div');
            masonryItem.className = 'aspect-[4/3] rounded overflow-hidden masonry-item';

            const caption = (data.displayCaption || data.prompt || '').trim();
            const img = document.createElement('img');
            img.src = data.localPath || data.url;
            img.alt = caption;
            const newId = (data && (data.id ?? data.image_id ?? data.imageId ?? (data.image && data.image.id))) || '';
            img.dataset.id = String(newId);

            img.dataset.url = img.src;
            img.dataset.prompt = caption;
            img.onclick = () => openModal(img);
            img.className = 'gallery-img w-full h-full object-cover rounded cursor-pointer opacity-0 transition-opacity duration-500 ease-in-out';

            // Fade in, then auto-open the modal the first time it loads
            img.addEventListener('load', () => {
                img.classList.remove('opacity-0');
                // Give the fade-in a tick so the modal feels snappy but not jarring
                setTimeout(() => openModal(img), 50);
            });

            masonryItem.appendChild(img);
            gallery.insertBefore(masonryItem, gallery.firstChild);

            form.reset();
            status.textContent = 'Added!';
            setTimeout(() => status.classList.add('hidden'), 1500);

        } catch (err) {
            console.error(err);
            status.textContent = 'Error: ' + err.message;
            status.className = 'text-sm text-red-600 mt-2';
        }
    });
</script>

<div id="imageModal" class="fixed inset-0 bg-black/80 z-50 hidden">
    <div class="w-full h-full p-4 sm:p-6 md:p-8 flex items-center justify-center">
        <!-- remove overflow-hidden here so inner padding is visible -->
        <div class="relative w-full max-w-5xl rounded-2xl shadow-2xl bg-white">
            <!-- Close Button (larger tap target) -->
            <button id="closeModal" aria-label="Close"
                    class="absolute top-4 right-4 h-10 w-10 grid place-items-center rounded-full bg-white/80 text-gray-700 hover:text-black shadow">
                &times;
            </button>

            <!-- Padded content wrapper -->
            <div class="bg-white rounded-2xl">
                <!-- Image area: center + hard max width so it never hugs the card edges -->
                <div class="px-3 pt-3 sm:px-6 sm:pt-6">
                    <!-- Centered container that limits the image width -->
                    <div class="mx-auto w-full max-w-[720px]">
                        <img
                                id="modalImage"
                                src=""
                                alt=""
                                decoding="async"
                                sizes="(max-width:640px) 92vw, 720px"
                                class="block w-full h-auto max-h-[72dvh] object-contain rounded-lg opacity-0 transition-opacity duration-300"
                                onload="this.style.opacity=1"
                        />
                    </div>
                </div>

                <!-- Caption + buttons -->
                <div class="p-4 sm:p-6 pt-4 pb-6 sm:pb-6">
                    <p id="modalPrompt" class="text-base leading-relaxed text-gray-700 italic"></p>
                    <div class="mt-4 flex flex-col sm:flex-row gap-3">
                        <a id="downloadBtn" href="#" download
                           class="inline-block px-4 py-3 text-sm font-medium text-white bg-gray-800 rounded hover:bg-gray-700 shadow text-center">
                            ⬇ Download
                        </a>
                        <button id="printBtn" type="button"
                                class="inline-block px-4 py-3 text-sm font-medium text-white bg-gray-900 rounded hover:bg-gray-800 shadow">
                            🖨 Request print
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    let currentImageId = null;
    let currentImgElement = null;

    function openModal(img) {
        const modal = document.getElementById("imageModal");
        const modalImage = document.getElementById("modalImage");
        const modalPrompt = document.getElementById("modalPrompt");
        const downloadBtn = document.getElementById("downloadBtn");

        modalImage.src = img.dataset.url;
        modalPrompt.textContent = img.dataset.prompt;
        downloadBtn.href = img.dataset.url;

        currentImageId = img.dataset.id;
        currentImgElement = img.closest(".masonry-item");

        modal.classList.remove("hidden");
        document.body.style.overflow = "hidden";
    }

    function closeModal() {
        document.getElementById("imageModal").classList.add("hidden");
        document.body.style.overflow = "auto";
        currentImageId = null;
        currentImgElement = null;
    }

    document.getElementById("closeModal").addEventListener("click", closeModal);
    document.getElementById("imageModal").addEventListener("click", (e) => {
        if (e.target.id === "imageModal") closeModal();
    });
    document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") closeModal();
    });

</script>
<script>
    // Now the DOM contains #printBtn, so we can safely bind.
    (function attachPrintHandler() {
        const printBtn = document.getElementById('printBtn');
        if (!printBtn) return; // defensive

        printBtn.addEventListener('click', async () => {
            if (!currentImageId) return;

            printBtn.disabled = true;
            const old = printBtn.textContent;
            printBtn.textContent = 'Queuing…';

            try {
                const res = await fetch(`/api/print/${currentImageId}`, { method: 'POST' });
                if (!res.ok) {
                    const t = await res.text();
                    printBtn.textContent = 'Failed';
                    setTimeout(() => { printBtn.textContent = old; printBtn.disabled = false; }, 1500);
                    console.error(t);
                    return;
                }
                printBtn.textContent = 'Queued!';
                setTimeout(() => { printBtn.textContent = '🖨 Request print'; printBtn.disabled = false; }, 2000);
            } catch (e) {
                console.error(e);
                printBtn.textContent = 'Error';
                setTimeout(() => { printBtn.textContent = old; printBtn.disabled = false; }, 1500);
            }
        });
    })();
</script>

<script src="https://kit.fontawesome.com/4ad52d1665.js" crossorigin="anonymous"></script>
<script>
    const consentCheckbox = document.getElementById('consentCheckbox');
    const genBtn = document.getElementById('genBtn');

    consentCheckbox.addEventListener('change', () => {
        genBtn.disabled = !consentCheckbox.checked;
    });

    // Optional: Check if already checked on load (useful if you're saving state)
    window.addEventListener('DOMContentLoaded', () => {
        genBtn.disabled = !consentCheckbox.checked;
    });
</script>
<script>
    document.querySelectorAll('details[data-exclusive]').forEach(detail => {
        detail.addEventListener('toggle', () => {
            if (detail.open) {
                document.querySelectorAll('details[data-exclusive]').forEach(other => {
                    if (other !== detail) other.removeAttribute('open');
                });
            }
        });
    });
</script>


</body>
</html>
